# ============================================================
# Manage-R Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/manage_r_db?schema=public

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Throttle / Rate Limiting ────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Swagger ─────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE=Manage-R API
SWAGGER_DESCRIPTION=Resume management and career tracking platform API
SWAGGER_VERSION=1.0
