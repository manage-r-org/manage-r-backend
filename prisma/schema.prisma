generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model certification {
  certification_id     BigInt                 @id @default(autoincrement())
  profile_id           BigInt?
  certification_name   String?                @db.VarChar(255)
  issuing_organization String?                @db.VarChar(255)
  issue_date           DateTime?              @db.Date
  expiry_date          DateTime?              @db.Date
  credential_url       String?                @db.VarChar(255)
  profile              profile?               @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  resume_certification resume_certification[]
}

model education {
  education_id     BigInt             @id @default(autoincrement())
  profile_id       BigInt?
  degree           String?            @db.VarChar(200)
  institution      String?            @db.VarChar(255)
  field_of_study   String?            @db.VarChar(255)
  grade            String?            @db.VarChar(50)
  start_date       DateTime?          @db.Date
  end_date         DateTime?          @db.Date
  is_current       Boolean?           @default(false)
  description      String?
  profile          profile?           @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  resume_education resume_education[]
}

model experience {
  experience_id             BigInt                      @id @default(autoincrement())
  profile_id                BigInt?
  company_name              String?                     @db.VarChar(255)
  position                  String?                     @db.VarChar(255)
  employment_type           String?                     @db.VarChar(100)
  location                  String?                     @db.VarChar(255)
  start_date                DateTime?                   @db.Date
  end_date                  DateTime?                   @db.Date
  is_current                Boolean?                    @default(false)
  description               String?
  profile                   profile?                    @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  experience_responsibility experience_responsibility[]
  resume_experience         resume_experience[]
}

model experience_responsibility {
  experience_id  BigInt
  display_order  Int
  responsibility String
  experience     experience @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([experience_id, display_order])
}

model job_application {
  job_application_id BigInt    @id @default(autoincrement())
  profile_id         BigInt?
  resume_id          BigInt?
  company_name       String?   @db.VarChar(255)
  position           String?   @db.VarChar(255)
  source             String?   @db.VarChar(100)
  job_url            String?
  status             String?   @db.VarChar(50)
  applied_on         DateTime? @db.Date
  interview_date     DateTime? @db.Timestamp(6)
  salary_offered     Decimal?  @db.Decimal(12, 2)
  notes              String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  profile            profile?  @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  resume             resume?   @relation(fields: [resume_id], references: [resume_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_job_application_status")
}

model login_log {
  login_log_id BigInt    @id @default(autoincrement())
  user_id      BigInt?
  login_at     DateTime? @default(now()) @db.Timestamp(6)
  ip_address   String?   @db.VarChar(64)
  user_agent   String?
  success      Boolean
  sec_user     sec_user? @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model master_resume_category {
  resume_category_id BigInt   @id @default(autoincrement())
  category_name      String   @unique @db.VarChar(100)
  description        String?
  resume             resume[]
}

model master_resume_template {
  template_id        BigInt   @id @default(autoincrement())
  template_name      String?  @db.VarChar(150)
  template_key       String?  @unique @db.VarChar(100)
  configuration_json Json?
  preview_image      String?  @db.VarChar(255)
  is_active          Boolean? @default(true)
  resume             resume[]
}

model master_skill {
  skill_id      BigInt          @id @default(autoincrement())
  skill_name    String          @unique @db.VarChar(100)
  description   String?
  profile_skill profile_skill[]
}

model profile {
  profile_id        BigInt            @id @default(autoincrement())
  user_id           BigInt            @unique
  first_name        String?           @db.VarChar(100)
  middle_name       String?           @db.VarChar(100)
  last_name         String?           @db.VarChar(100)
  dob               DateTime?         @db.Date
  headline          String?           @db.VarChar(200)
  summary           String?
  email             String?           @db.VarChar(255)
  phone             String?           @db.VarChar(30)
  website           String?           @db.VarChar(255)
  linkedin_url      String?           @db.VarChar(255)
  github_url        String?           @db.VarChar(255)
  present_address   String?
  permanent_address String?
  created_at        DateTime?         @default(now()) @db.Timestamp(6)
  updated_at        DateTime?         @updatedAt @db.Timestamp(6)
  certification     certification[]
  education         education[]
  experience        experience[]
  job_application   job_application[]
  sec_user          sec_user          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  profile_skill     profile_skill[]
  project           project[]
  resume            resume[]
}

model profile_skill {
  profile_id          BigInt
  skill_id            BigInt
  proficiency         Int?           @db.SmallInt
  years_of_experience Decimal?       @db.Decimal(4, 1)
  profile             profile        @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  master_skill        master_skill   @relation(fields: [skill_id], references: [skill_id], onDelete: NoAction, onUpdate: NoAction)
  resume_skill        resume_skill[]

  @@id([profile_id, skill_id])
}

model project {
  project_id        BigInt              @id @default(autoincrement())
  profile_id        BigInt?
  project_name      String?             @db.VarChar(255)
  tech_stack        String?
  live_url          String?             @db.VarChar(255)
  github_url        String?             @db.VarChar(255)
  description       String?
  profile           profile?            @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  project_highlight project_highlight[]
  resume_project    resume_project[]
}

model project_highlight {
  project_id    BigInt
  display_order Int
  highlight     String
  project       project @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([project_id, display_order])
}

model resume {
  resume_id              BigInt                  @id @default(autoincrement())
  public_id              String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id             BigInt
  template_id            BigInt?
  resume_category_id     BigInt?
  title                  String                  @db.VarChar(200)
  target_role            String?                 @db.VarChar(200)
  description            String?
  version_no             Int?                    @default(1)
  status                 String?                 @default("DRAFT") @db.VarChar(20)
  is_public              Boolean?                @default(false)
  theme_json             Json?
  created_at             DateTime?               @default(now()) @db.Timestamp(6)
  updated_at             DateTime?               @db.Timestamp(6)
  job_application        job_application[]
  profile                profile                 @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade, onUpdate: NoAction)
  master_resume_category master_resume_category? @relation(fields: [resume_category_id], references: [resume_category_id], onDelete: NoAction, onUpdate: NoAction)
  master_resume_template master_resume_template? @relation(fields: [template_id], references: [template_id], onDelete: NoAction, onUpdate: NoAction)
  resume_certification   resume_certification[]
  resume_education       resume_education[]
  resume_experience      resume_experience[]
  resume_project         resume_project[]
  resume_skill           resume_skill[]

  @@index([public_id], map: "idx_resume_public_id")
}

model resume_certification {
  resume_id        BigInt
  certification_id BigInt
  display_order    Int?          @default(1)
  certification    certification @relation(fields: [certification_id], references: [certification_id], onDelete: Cascade, onUpdate: NoAction)
  resume           resume        @relation(fields: [resume_id], references: [resume_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([resume_id, certification_id])
}

model resume_education {
  resume_id     BigInt
  education_id  BigInt
  display_order Int?      @default(1)
  education     education @relation(fields: [education_id], references: [education_id], onDelete: Cascade, onUpdate: NoAction)
  resume        resume    @relation(fields: [resume_id], references: [resume_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([resume_id, education_id])
}

model resume_experience {
  resume_id     BigInt
  experience_id BigInt
  display_order Int?       @default(1)
  experience    experience @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade, onUpdate: NoAction)
  resume        resume     @relation(fields: [resume_id], references: [resume_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([resume_id, experience_id])
}

model resume_project {
  resume_id     BigInt
  project_id    BigInt
  display_order Int?    @default(1)
  project       project @relation(fields: [project_id], references: [project_id], onDelete: Cascade, onUpdate: NoAction)
  resume        resume  @relation(fields: [resume_id], references: [resume_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([resume_id, project_id])
}

model resume_skill {
  resume_id     BigInt
  profile_id    BigInt
  skill_id      BigInt
  display_order Int?          @default(1)
  profile_skill profile_skill @relation(fields: [profile_id, skill_id], references: [profile_id, skill_id], onDelete: NoAction, onUpdate: NoAction)
  resume        resume        @relation(fields: [resume_id], references: [resume_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([resume_id, profile_id, skill_id])
}

model sec_role {
  role_id     BigInt     @id @default(autoincrement())
  role_name   String     @unique @db.VarChar(50)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  sec_user    sec_user[]
}

model sec_user {
  user_id       BigInt      @id @default(autoincrement())
  role_id       BigInt
  username      String      @unique @db.VarChar(100)
  email         String      @unique @db.VarChar(255)
  phone_number  String?     @db.VarChar(30)
  password_hash String
  is_active     Boolean     @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @db.Timestamp(6)
  login_log     login_log[]
  profile       profile?
  sec_role      sec_role    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
}
